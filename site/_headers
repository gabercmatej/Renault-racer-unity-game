# Unity Web build f1088dc (PRODUCTION). wasm and data are precompressed Brotli with
# Decompression Fallback off, so these two must be served with Content-Encoding: br.
# framework.js ships uncompressed on purpose; Netlify compresses it on the fly like any
# other .js, so it only needs caching here.
#
# Exact paths on purpose: the file names are content hashes. After replacing site/demo
# with a new build, update the paths below to match site/demo/Build/.

/demo/Build/24fe6233827ecbe1f5fa9174b61a67c0.wasm.br
  Content-Encoding: br
  Content-Type: application/wasm
  Cache-Control: public, max-age=31536000, immutable

/demo/Build/189eb040abeedf3b28f727382166ff5d.data.br
  Content-Encoding: br
  Content-Type: application/octet-stream
  Cache-Control: public, max-age=31536000, immutable

/demo/Build/6dc486ec5889a5f09ec9f1e3bb35563c.framework.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: public, max-age=31536000, immutable

/demo/Build/9e8090afd794a9e4404f0887e48d1934.loader.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: public, max-age=31536000, immutable

/demo/build-identity.json
  Cache-Control: public, max-age=0, must-revalidate
